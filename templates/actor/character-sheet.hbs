                  </span>
                  <span class="sorcery-total-large" title="Total % (Invested + Magic Rating - Encumbrance)">{{spell.totalPercent}}%</span>
                  <a class="spell-cast {{#unless spell.canCast}}disabled{{/unless}}" title="{{#if spell.canCast}}Cast Spell{{else}}Not enough MP to cast{{/if}}" style="{{#unless spell.canCast}}opacity: 0.4; cursor: not-allowed;{{/unless}}"><i class="fas fa-dice-d20"></i></a>
                  <a class="spell-delete" title="Delete Spell"><i class="fas fa-trash"></i></a>
                </div>
              </div>
              {{else}}
              <div class="empty-spell-section">
                <p>Drag sorcery spells here (does not use Free INT)</p>
              </div>
              {{/each}}
                  </div>
                </div>
              </div>
              
              <!-- Unavailable Section -->
              <div class="spell-storage-accordion magic-accordion collapsed" data-magic-type="sorcery-unavailable">
                <div class="spell-storage-header accordion-header" data-accordion-target="sorcery-unavailable">
                  <h6>{{localize "RQ3.Magic.unavailable"}}</h6>
                  <i class="fas fa-chevron-down accordion-icon"></i>
                </div>
                <div class="accordion-content" data-accordion-content="sorcery-unavailable">
                  <div class="sorcery-items-list unavailable-list" data-spell-type="sorcery" data-spell-storage="unavailable">
              {{#each sorcerySpellsUnavailable as |spell id|}}
              <div class="equipment-item-row spell-item sorcery-spell-item" data-item-id="{{spell._id}}" data-item-type="spell" data-storage-location="sorcery" data-spell-storage="unavailable" draggable="true">
                <img class="spell-image" src="{{itemImage spell}}" title="{{spell.name}}" alt="{{spell.name}}" onerror="this.onerror=null; this.src='icons/svg/book.svg';"/>
                <div class="spell-details">
                  <span class="spell-name">{{spell.name}}</span>
                  <div class="spell-stats">
                    <span class="spell-stat" title="Range"><i class="fas fa-crosshairs"></i> {{spell.system.range}}</span>
                    <span class="spell-stat" title="Duration"><i class="fas fa-clock"></i> {{spell.system.duration}}</span>
                  </div>
                </div>
                <div class="spell-controls">
                  <span class="sorcery-invested-large" title="Invested Points">
                    <i class="fas fa-cog sorcery-spell-cog" data-spell-id="{{spell._id}}" title="Edit Invested Points"></i>
                    {{spell.system.invested}}%
                  </span>
                  <span class="sorcery-total-large" title="Total % (Invested + Magic Rating - Encumbrance)">{{spell.totalPercent}}%</span>
                  <a class="spell-cast disabled" title="Cannot cast - spell is unavailable" style="opacity: 0.4; cursor: not-allowed;"><i class="fas fa-dice-d20"></i></a>
                  <a class="spell-delete" title="Delete Spell"><i class="fas fa-trash"></i></a>
                </div>
              </div>
              {{else}}
              <div class="empty-spell-section">
                <p>Drag sorcery spells here (cannot be cast)</p>
              </div>
              {{/each}}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Background Tab -->
    <div class="tab" data-group="primary" data-tab="background">
      <div class="background-section">
        <div class="biography-section">
          <h5>{{localize "RQ3.Labels.biography"}}</h5>
          <textarea name="system.background.biography" rows="10">{{system.background.biography}}</textarea>
        </div>
        <div class="notes-section">
          <h5>{{localize "RQ3.Labels.notes"}}</h5>
          <textarea name="system.background.notes" rows="6">{{system.background.notes}}</textarea>
        </div>
      </div>
    </div>
  </section>
</form> 