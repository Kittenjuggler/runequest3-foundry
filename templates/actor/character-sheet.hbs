                    <span class="ap-value">{{#if system.equippedArmor.head}}{{#each @root.items as |item|}}{{#if (eq item._id @root.system.equippedArmor.head)}}{{formatAP item.system.hitLocations.head item.system.armorDamage.head @root.system.hitLocations.head.tempArmor}}{{/if}}{{/each}}{{else}}{{#if system.hitLocations.head.tempArmor}}0+{{system.hitLocations.head.tempArmor}}/0{{else}}0/0{{/if}}{{/if}}</span>
